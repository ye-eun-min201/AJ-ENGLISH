# 이 파일을 .env.local 로 복사해 값을 채우면 `npm run dev` 가 읽습니다.
# Vercel 에서는 Settings → Environment Variables 에 같은 이름으로 넣습니다.
# 실제 값이 들어간 파일은 GitHub 에 올리지 마세요. (.gitignore 가 막아 둡니다)

# 관리자 페이지(/admin) 비밀번호
ADMIN_PASSWORD=

# 사이트 주소 (끝에 / 없이). 예: https://aj-english.vercel.app
PUBLIC_ORIGIN=

# 데이터베이스 — Vercel 에서 Turso 를 연결하면 자동으로 들어갑니다
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 파일 창고 — Vercel 에서 Blob(Private)을 연결하면 자동으로 들어갑니다
BLOB_READ_WRITE_TOKEN=

# 카카오 로그인  ·  리다이렉트 URI: (사이트 주소)/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 구글 로그인  ·  리디렉션 URI: (사이트 주소)/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
